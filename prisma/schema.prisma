generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id             String   @id @default(uuid()) @db.Uuid
  full_name      String
  email          String   @unique
  password_hash  String?
  matric_no      String?  @unique
  hall           String?
  avatar_url     String?  @db.Text
  role           String   @default("student")
  council_role   String?
  council_active Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  // Existing campus service relationships
  arrivals       ArrivalRequest[]
  lost_reports   LostReport[]
  hostel_reports HostelReport[]

  // Messaging relationships
  sent_messages     Message[] @relation("MessageSender")
  received_messages Message[] @relation("MessageRecipient")

  // Notifications
  notifications Notification[]

  @@map("profiles")
}

model ArrivalRequest {
  id               String    @id @default(uuid()) @db.Uuid
  student_id       String    @db.Uuid
  item_description String
  quantity         Int       @default(1)
  notes            String?   @db.Text
  expected_date    DateTime
  arrival_time     String    @default("09:00")
  delivery_method  String    @default("self")
  transport_charge Int       @default(0)
  emergency        Boolean   @default(false)
  status           String    @default("SUBMITTED")
  assigned_officer String?
  delivery_pin     String?
  contraband       Json      @default("[]")
  inspection_notes String?   @db.Text
  delivered_at     DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  student Profile @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([student_id, created_at])
  @@index([status, expected_date])
  @@map("arrival_requests")
}

model GateSchedule {
  id           String   @id @default(uuid()) @db.Uuid
  title        String   @default("Official Gate Date")
  gate_date    DateTime
  days         Json     @default("[]")
  hours        String   @default("08:00 - 17:30")
  opening_time String   @default("08:00")
  closing_time String   @default("17:30")
  notes        String?  @db.Text
  published_by String?  @db.Uuid
  active       Boolean  @default(true)
  published_at DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([active, gate_date])
  @@map("gate_schedules")
}

model LostReport {
  id                String   @id @default(uuid()) @db.Uuid
  student_id        String   @db.Uuid
  item_name         String
  location          String
  description       String   @db.Text
  proof_url         String?  @db.Text
  proof_description String?  @db.Text
  status            String   @default("open")
  matched_found_id  String?  @db.Uuid
  council_notes     String?  @db.Text
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  student Profile @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([student_id, created_at])
  @@map("lost_reports")
}

model FoundItem {
  id                     String    @id @default(uuid()) @db.Uuid
  item_name              String
  location               String
  description            String    @db.Text
  image_url              String?   @db.Text
  reported_by            String?   @db.Uuid
  reporter_type          String    @default("STUDENT")
  status                 String    @default("available")
  claimed_by             String?   @db.Uuid
  claimed_at             DateTime?
  matched_lost_report_id String?   @db.Uuid
  claim_note             String?   @db.Text
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  @@index([status, created_at])
  @@map("found_items")
}

model HostelReport {
  id          String   @id @default(uuid()) @db.Uuid
  student_id  String   @db.Uuid
  issue_type  String
  hall        String?
  room_area   String?
  priority    String   @default("Medium")
  description String   @db.Text
  status      String   @default("Open")
  assigned_to String?
  resolution  String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  student Profile @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([status, priority, created_at])
  @@map("hostel_watch_reports")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actor_id    String?  @db.Uuid
  actor_label String
  message     String   @db.Text
  severity    String   @default("info")
  created_at  DateTime @default(now())

  @@index([created_at])
  @@map("audit_logs")
}

model Message {
  id           String @id @default(uuid()) @db.Uuid
  sender_id    String @db.Uuid
  recipient_id String @db.Uuid

  subject String @db.VarChar(200)
  body    String @db.Text

  is_read Boolean   @default(false)
  read_at DateTime?

  // Email delivery tracking
  email_status  String    @default("NOT_SENT")
  email_sent_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  sender    Profile @relation("MessageSender", fields: [sender_id], references: [id], onDelete: Cascade)
  recipient Profile @relation("MessageRecipient", fields: [recipient_id], references: [id], onDelete: Cascade)

  // Message attachments
  attachments MessageAttachment[]

  @@index([recipient_id, is_read, created_at])
  @@index([sender_id, created_at])
  @@map("messages")
}

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  title      String    @db.VarChar(200)
  message    String    @db.Text
  type       String    @default("MESSAGE")
  link       String?   @db.Text
  is_read    Boolean   @default(false)
  read_at    DateTime?
  created_at DateTime  @default(now())

  user Profile @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read, created_at])
  @@map("notifications")
}

model MessageAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  message_id  String   @db.Uuid
  file_name   String   @db.VarChar(255)
  file_url    String   @db.Text
  mime_type   String   @db.VarChar(150)
  file_size   Int
  storage_key String?  @db.Text
  created_at  DateTime @default(now())

  message Message @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@index([message_id])
  @@map("message_attachments")
}

model CourseAnnouncement {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(180)
  course_code String   @db.VarChar(40)
  department  String   @db.VarChar(160)
  level       String   @db.VarChar(20)
  description String   @db.Text
  active      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([active, created_at])
  @@index([department, level])
  @@map("course_announcements")
}
# Local PostgreSQL database. Create lmu_campus_care in pgAdmin first.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/lmu_campus_care?schema=public"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
# Optional Google OAuth. Google sign-in is shown only when both values are configured.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
